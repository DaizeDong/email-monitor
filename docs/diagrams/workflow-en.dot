// Public workflow documentation. Contains no runtime mail or account data.
// Render both languages: python docs/diagrams/render.py
digraph workflow {
  graph [rankdir=LR, bgcolor="white", pad="0.16", nodesep="0.30", ranksep="0.32", fontname="Arial", splines=polyline];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=16, fontcolor="#0f172a", penwidth=1.6, margin="0.16,0.12"];
  edge [fontname="Arial", fontsize=12, color="#64748b", fontcolor="#475569", penwidth=1.4, arrowsize=0.75];

  read [label=<<B>Read + classify</B><BR/><FONT POINT-SIZE="13">Deduplicate mail</FONT>>, fillcolor="#eef2ff", color="#6366f1"];
  save [label=<<B>Save intents</B><BR/><FONT POINT-SIZE="13">PRIVATE cursor + keys</FONT>>, fillcolor="#f1f5f9", color="#475569"];
  actions [label=<<B>Enabled actions</B><BR/><FONT POINT-SIZE="13">Alerts · pool · archive · labels</FONT>>, fillcolor="#e0f2fe", color="#0284c7"];
  confirm [label=<<B>Confirm action</B><BR/><FONT POINT-SIZE="13">Receipt + key match</FONT>>, fillcolor="#fef9c3", color="#ca8a04"];
  done [label=<<B>Mark done</B>>, fillcolor="#dcfce7", color="#16a34a"];
  unresolved [label=<<B>Reconcile</B><BR/><FONT POINT-SIZE="13">Retry if proven not applied</FONT>>, fillcolor="#fff1f2", color="#e11d48"];
  draft [label=<<B>Caller session</B><BR/><FONT POINT-SIZE="13">Lint + Gmail draft</FONT>>, fillcolor="#e0f2fe", color="#0284c7"];
  send [label=<<B>User reviews</B><BR/><FONT POINT-SIZE="13">Manual Gmail send</FONT>>, fillcolor="#dcfce7", color="#16a34a"];

  read -> save -> actions -> confirm;
  confirm -> done [label="Yes", color="#16a34a", fontcolor="#15803d"];
  confirm -> unresolved [label="No", color="#e11d48", fontcolor="#be123c"];
  read -> draft [label="On request", style=dashed, color="#0284c7", fontcolor="#0369a1"];
  draft -> send [color="#0284c7"];

  { rank=same; save; draft; }
  { rank=same; actions; confirm; send; }
  { rank=same; done; unresolved; }
  confirm -> send [style=invis];
}
